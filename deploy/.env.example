# Peanut Reacts Pipeline - Cloud deployment environment template
# Copy to .env and fill in real values

# ── LLM ────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.85

# ── YouTube ────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIza...
YOUTUBE_CLIENT_SECRETS=/secrets/client_secret.json
UPLOAD_PRIVACY=public

# ── Optional: TTS / Visual ─────────────────────────────────────
ELEVENLABS_API_KEY=
HF_TOKEN=
FAL_KEY=
FAL_API_KEY=

# ── Notifications ──────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Storage paths (inside container) ───────────────────────────
OUTPUT_DIR=/output
WORK_DIR=/data/work
PROGRESS_FILE=/data/peanut_progress.json

# ── Pipeline DB paths ──────────────────────────────────────────
PIPELINE_DB=/data/pipeline.db
LEARNING_DB=/data/learning.db

# ── yt-dlp cookies (optional for age-gated content) ────────────
YTDLP_COOKIES_FILE=/secrets/cookies.txt

# ── Scheduler ──────────────────────────────────────────────────
APSCHEDULER_TIMEZONE=Europe/Amsterdam
