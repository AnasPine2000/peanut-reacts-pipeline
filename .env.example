# ─── Peanut Reacts Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your keys.
# All values can also be passed as CLI flags.

# YouTube Data API v3 (for fetching comments)
YOUTUBE_API_KEY=

# LLM Provider (deepseek, groq, or ollama)
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# YouTube Upload (OAuth client secrets JSON from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=
UPLOAD_PRIVACY=private
AUTO_UPLOAD=false

# Speaker diarization (color-coded subtitles)
# Get a free token at https://huggingface.co/settings/tokens
# Also accept the pyannote model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Optional: yt-dlp cookies file path (for age-restricted / geo-blocked videos)
# Export from browser using "Get cookies.txt LOCALLY" extension
YTDLP_COOKIES_FILE=
